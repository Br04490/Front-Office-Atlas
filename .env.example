# ==============================================================================
# FRONT OFFICE ATLAS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development. Never commit real credentials.

# AI Studio Core Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# BROWSER / CLIENT-SIDE CONFIGURATION
# Rule: Browser/client code may ONLY access SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Vite client-prefixed aliases for React front-end access (if required by build tool)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# ------------------------------------------------------------------------------
# SERVER-SIDE ONLY CONFIGURATION (NEVER EXPOSE TO BROWSER / CLIENT-SIDE CODE)
# Rule: Server-side code may use SUPABASE_SECRET_KEY, DATABASE_URL, GOOGLE_AI_API_KEY.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/front_office_atlas"
SUPABASE_SECRET_KEY="your-secret-key"
GOOGLE_AI_API_KEY="your-google-ai-api-key"
